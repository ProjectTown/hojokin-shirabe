---
/**
 * 都道府県ページ。
 *
 * その県だけを対象にした制度に絞って表示する。
 * 全国対象の制度は /national/ に集約した。全ページに載せると
 * どの県も同じ内容になり、実測で最大100%一致していたため。
 */
import Base from "../../layouts/Base.astro";
import SubsidyCard from "../../components/SubsidyCard.astro";
import { subsidies, byArea, PREF_SLUG, INDUSTRY_SLUG, dataset, isIndexableArea } from "../../lib/data";

export function getStaticPaths() {
  return Object.entries(PREF_SLUG).map(([pref, slug]) => ({ params: { pref: slug }, props: { pref } }));
}

const { pref } = Astro.props;
const local = byArea(pref).filter((s) => !s.isNational);
const nationalCount = subsidies.filter((s) => s.isNational).length;

// この県の制度が実際に対象としている業種だけ出す
const industries = dataset.facets.industries.filter((i) => local.some((s) => s.industries.includes(i)));

const title = `${pref}独自の補助金${local.length}件｜補助金しらべ`;
const description = `${pref}が独自に実施している募集中の補助金を${local.length}件掲載。上限額・補助率・締切を横並びで比較できます。全国対象の制度は別ページにまとめています。`;
---

<Base title={title} description={description} noindex={!isIndexableArea(pref)}>
  <p class="crumbs"><a href="/">トップ</a> ／ <a href="/area/">地域から探す</a> ／ {pref}</p>

  <h1>{pref}独自の補助金</h1>
  <p class="lead">
    {pref}や県内の自治体が実施していて、対象地域に{pref}が指定されている制度 <b>{local.length}件</b> です。
    締切が近い順に並べています。
  </p>

  <div class="notice">
    このほかに、地域を問わず使える<a href="/national/">全国対象の制度が{nationalCount}件</a>あります。
    {pref}の事業者はそちらも対象になり得ます。
  </div>

  {local.length > 0 ? (
    <ul class="card-list">{local.map((s) => <SubsidyCard s={s} />)}</ul>
  ) : (
    <div class="empty">
      <p><b>現在、{pref}独自の募集中の制度は公開データに登録されていません。</b></p>
      <p><a href="/national/">全国対象の制度{nationalCount}件</a>をご確認ください。</p>
    </div>
  )}

  {industries.length > 0 && (
    <>
      <h2>業種で絞り込む</h2>
      <p class="lead">全国対象の制度も含めた絞り込み結果を表示します。</p>
      <ul class="facets">
        {industries.map((i) => (
          <li>
            <a href={`/find/${PREF_SLUG[pref]}/${INDUSTRY_SLUG[i]}/`}>
              {i} <span class="count">{local.filter((s) => s.industries.includes(i)).length}件</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="notice">
    掲載情報はデジタル庁の公開データを整理したものです。
    <strong>受給可否の判定は行っていません。</strong>
    市区町村独自の制度など、公開APIに登録されていない補助金は掲載されない場合があります。
  </div>
</Base>
